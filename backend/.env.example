# --- LLM -------------------------------------------------------------------
# mock: chạy không cần key (dữ liệu mẫu) · openrouter · openai (mọi endpoint OpenAI-compatible:
# OpenAI, Ollama http://127.0.0.1:11434/v1, vLLM…) · vibeflow
LLM_PROVIDER=mock         # đổi thành openrouter sau khi dán key đầy đủ

# OpenRouter (LLM_PROVIDER=openrouter). Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-
# Claude Opus 5.5 qua OpenRouter: $4 / $20 mỗi 1 triệu token vào / ra (cần nạp credit)
MODEL_NAME=anthropic/claude-opus-5.5
LLM_JSON_MODE=false           # Opus tự trả JSON theo prompt; không cần ép

# openai / vibeflow (OpenRouter tự dùng https://openrouter.ai/api/v1 khi để trống)
LLM_BASE_URL=
LLM_API_KEY=

LLM_TEMPERATURE=              # để trống: không gửi (Opus 5.5 không nhận temperature)
LLM_TIMEOUT_S=600             # bước WBS/proposal có thể mất vài phút
LLM_MAX_RETRIES=4             # thử lại lỗi mạng, 429 (model free hay bận), response rỗng

# Cache: response hợp lệ lưu ở backend/llm_cache/<bước>/*.json; cùng model + prompt + dữ liệu
# thì đọc lại, không gọi LLM. Xóa thư mục (hoặc file của một bước) để gọi lại.
LLM_CACHE=true
LLM_CACHE_DIR=llm_cache

# --- Khác --------------------------------------------------------------------
PII_MASKING=true
DB_PATH=./scopeai.db
CORS_ORIGINS=http://localhost:5173
LLM_MAX_TOKENS=64000          # gồm cả token suy luận; WBS dự án lớn có thể ~100 task
LLM_REASONING_EFFORT=         # trống = mặc định của model (medium); low rẻ hơn, high kỹ hơn
